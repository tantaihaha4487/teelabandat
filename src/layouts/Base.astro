---
import '../styles/global.css';
import '../styles/motion.css';
import '@fontsource/ibm-plex-sans-thai/400.css';
import '@fontsource/ibm-plex-sans-thai/500.css';
import '@fontsource/ibm-plex-sans-thai/600.css';
import '@fontsource/jetbrains-mono/400.css';
import Icon from '../components/Icon.astro';
import Mascot from '../components/Mascot.astro';
import { sections, sectionUrl } from '../lib/content';
interface Props { title: string; description?: string; current?: string; wide?: boolean; }
const { title, description = 'บทเรียน Python และ Git ภาษาไทย พร้อมคำอธิบายโค้ดทีละบรรทัด และแบบฝึกสำหรับผู้เริ่มต้น', current = '', wide = false } = Astro.props;
const nav = await sections();
---
<!doctype html>
<html lang="th">
  <head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#FAF6F0"/><meta name="description" content={description}/><title>{title} · ทีละบรรทัด</title><link rel="icon" type="image/svg+xml" href="/favicon.svg"/></head>
  <body>
    <a class="skip-link" href="#main">ข้ามไปเนื้อหา</a>
    <div class="reading-progress" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href="/" aria-label="ทีละบรรทัด หน้าหลัก"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span><span>ทีละบรรทัด<small>อ่านโค้ดให้เข้าใจ</small></span></a>
      <nav class="desktop-nav" aria-label="เมนูหลัก"><a href="/learn/" aria-current={current === 'learn' ? 'page' : undefined}>บทเรียนทั้งหมด</a>{nav.slice(0, 3).map(s => <a href={sectionUrl(s)} aria-current={current === s.id ? 'page' : undefined}>{s.label}</a>)}{nav.length > 3 && <a href="/learn/">หมวดอื่น ๆ</a>}</nav>
      <a class="header-search" href="/search/" aria-label="ค้นหาบทเรียน"><Icon name="search" size={19}/><span>ค้นหา</span></a>
      <details class="mobile-nav"><summary>เมนู <span aria-hidden="true">+</span></summary><nav aria-label="เมนูบนมือถือ"><a href="/learn/">บทเรียนทั้งหมด</a>{nav.map(s=><a href={sectionUrl(s)} aria-current={current === s.id ? 'page' : undefined}>{s.label}</a>)}</nav></details>
    </header>
    <main id="main" class:list={['main-shell', { wide }]}><slot/></main>
    <footer class="site-footer"><a class="footer-brand" href="/">ทีละบรรทัด<span>อ่าน ลองเขียน แล้วค่อยไปต่อ</span></a><nav aria-label="ท้ายหน้า"><a href="/learn/">เลือกบทเรียน</a><a href="/search/">ค้นหาเนื้อหา</a></nav><div class="footer-companion"><Mascot pose="nap" class="footer-mascot"/><p>เรียนได้ตามจังหวะของตัวเอง</p></div></footer>
  </body>
</html>
