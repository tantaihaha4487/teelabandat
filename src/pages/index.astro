---
import Base from '../layouts/Base.astro';
import SectionIndex from '../components/SectionIndex.astro';
import Icon from '../components/Icon.astro';
import Mascot from '../components/Mascot.astro';
import Shape from '../components/Shape.astro';
import { sections, lessons, lessonUrl } from '../lib/content';
const allSections = await sections();
const allLessons = await lessons();
const picks = ['python101/setup', 'python101/basics', 'git101/setup', 'git101/staging-commits'].map(id => allLessons.find(l => l.id === id)).filter(Boolean);
const pickShapes = ['cookie', 'clover', 'flower', 'burst'] as const;
---
<Base title="เริ่มเรียน Python และ Git">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="hero-chip"><span class="hero-chip__dot" aria-hidden="true"></span>พื้นที่เรียนรู้สำหรับคนเริ่มเขียน</p>
      <h1 id="home-title"><span class="hero-line">เข้าใจโค้ด</span><span class="hero-line">ทีละ<span class="hero-pill">บรรทัด</span></span></h1>
      <p class="hero-description">เรียน Python ตั้งแต่พื้นฐาน ใช้ Git เก็บประวัติงาน แล้วลองทำโจทย์พร้อมคำอธิบายภาษาไทย</p>
      <div class="hero-actions">
        <a class="button button--lg" href="/learn/python101/setup/"><span>เริ่มบทแรก</span><span class="button__icon"><Icon name="arrow" size={20} stroke={2}/></span></a>
        <a class="button button--tonal button--lg" href="#courses"><span>เลือกเรื่องที่อยากเรียน</span><Icon name="down" size={18} stroke={2}/></a>
      </div>
      <p class="hero-small"><Icon name="check" size={18} stroke={2.2}/>ยังไม่เคยเขียนโปรแกรมก็เริ่มได้</p>
    </div>

    <div class="hero-stage">
      <div class="hero-orbit" aria-hidden="true">
        <Shape kind="sunny" class="hero-orbit__sun"/>
        <Shape kind="clover" class="hero-orbit__clover"/>
        <Shape kind="burst" class="hero-orbit__burst"/>
        <span class="hero-orbit__name">มาชิโระ</span>
        <span class="hero-mascot-wrap"><Mascot pose="sparkling" class="hero-mascot" eager/></span>
      </div>
      <aside class="line-card" aria-label="วิธีอ่านตัวอย่างในบทเรียน">
        <h2>โค้ดแต่ละบรรทัด กำลังทำอะไร?</h2>
        <div class="line-card__code"><span class="line-card__number">01</span><code>name = <em>"Mashiro"</em></code></div>
        <div class="line-card__note"><span class="line-card__index">บรรทัดที่ 1</span><p>เก็บข้อความ <code>"Mashiro"</code> ไว้ในชื่อ <code>name</code> เพื่อเรียกค่านี้มาใช้ต่อ</p></div>
        <a class="line-card__link" href="/learn/python101/basics/"><span>อ่านต่อเรื่องตัวแปร</span><span class="line-card__go"><Icon name="arrow" size={18} stroke={2}/></span></a>
      </aside>
    </div>
  </section>

  <section class="home-courses" id="courses" aria-labelledby="course-title">
    <div class="section-heading">
      <h2 id="course-title">เลือกเริ่มจากเรื่องนี้</h2>
      <p>แต่ละส่วนอ่านแยกกันได้ ถ้าเพิ่งเริ่ม แนะนำ Python บทแรก</p>
    </div>
    <SectionIndex sections={allSections}/>
  </section>

  <section class="reading-picks" aria-labelledby="picks-title">
    <div class="reading-picks__intro">
      <h2 id="picks-title">เตรียมเครื่องมือ แล้วลองเขียน</h2>
      <p>บทพื้นฐานสำหรับเริ่มต้น ก่อนขยับไปเรื่องถัดไป</p>
    </div>
    <ol>
      {picks.map((l, i) => l && <li><a href={lessonUrl(l)}>
        <span class="pick-badge"><Shape kind={pickShapes[i % pickShapes.length]}/><span>{i + 1}</span></span>
        <span class="pick-text"><small>{l.data.section === 'python101' ? 'Python' : 'Git'}</small><strong>{l.data.title}</strong></span>
        <span class="pick-go"><Icon name="arrow" size={20} stroke={2}/></span>
      </a></li>)}
    </ol>
  </section>
</Base>
