---
import Base from '../layouts/Base.astro';
import Mascot from '../components/Mascot.astro';
import Shape from '../components/Shape.astro';
import SearchPanel from '../components/interactive/SearchPanel.vue';
import { searchIndex } from '../lib/content';
const entries = await searchIndex();
---
<Base title="ค้นหาเนื้อหา"><header class="page-intro mascot-intro"><div><h1>ค้นหาเนื้อหา</h1><p>ค้นด้วยคำภาษาไทย ชื่อคำสั่ง หรือเรื่องที่กำลังสงสัย</p></div><span class="intro-mascot"><Shape kind="clover" class="intro-mascot__shape"/><Mascot pose="think" class="search-mascot" eager/></span></header><SearchPanel entries={entries} client:load/><noscript><p class="callout">เปิด JavaScript เพื่อค้นหา หรือ <a href="/learn/">เปิดสารบัญบทเรียนทั้งหมด</a></p></noscript></Base>
