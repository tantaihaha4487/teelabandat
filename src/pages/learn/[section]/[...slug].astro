---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import Mascot from '../../../components/Mascot.astro';
import Shape from '../../../components/Shape.astro';
import { sections, lessons, lessonUrl } from '../../../lib/content';
export async function getStaticPaths() { return (await lessons()).map(lesson=>({ params:{ section:lesson.data.section, slug:lesson.id.replace(/^.*?\//,'') }, props:{ lesson } })); }
const { lesson } = Astro.props;
const section = (await sections()).find(s=>s.id===lesson.data.section)!;
const siblings = (await lessons()).filter(l=>l.data.section===lesson.data.section);
const index = siblings.findIndex(l=>l.id===lesson.id);
const previous = siblings[index-1], next = siblings[index+1];
const { Content, headings } = await render(lesson);
const chapterNav = siblings.map((l,i)=>({ href: lessonUrl(l), title: l.data.title, number: String(i+1).padStart(2,'0'), current: l.id===lesson.id }));
---
<Base title={lesson.data.title} description={lesson.data.description} current={section.id} wide>
  <div class="lesson-shell">
    <aside class="chapter-sidebar">
      <a class="sidebar-home" href={`/learn/${section.id}/`}><span class="sidebar-home__icon"><Shape kind="cookie"/><Icon name={section.icon} size={20}/></span>{section.label}</a>
      <div class="lesson-navigation desktop-chapter-nav"><p class="sidebar-label">บทเรียนในหมวดนี้</p><nav aria-label="รายการบทเรียน">{chapterNav.map(l=><a href={l.href} aria-current={l.current?'page':undefined}><span>{l.number}</span>{l.title}</a>)}</nav></div>
      <details class="lesson-navigation mobile-chapter-nav"><summary>เลือกบทเรียนในหมวดนี้</summary><nav aria-label="รายการบทเรียน">{chapterNav.map(l=><a href={l.href} aria-current={l.current?'page':undefined}><span>{l.number}</span>{l.title}</a>)}</nav></details>
    </aside>
    <article class="lesson-article">
      <div class="breadcrumbs"><a href="/learn/">บทเรียน</a><span aria-hidden="true">/</span><a href={`/learn/${section.id}/`}>{section.label}</a></div>
      <header class="article-header"><p class="chip chip--static">บทความ {String(index+1).padStart(2,'0')} / {String(siblings.length).padStart(2,'0')}</p><h1 style={`view-transition-name: lesson-${lesson.id.replace(/[^a-z0-9]+/gi,'-')}`}>{lesson.data.title}</h1><p>{lesson.data.description}</p></header>
      <div class="prose"><Content/></div>
      <nav class="lesson-pagination" aria-label="อ่านบทถัดไป">
        {previous ? <a class="prev-lesson" href={lessonUrl(previous)}><small><Icon name="back" size={16} stroke={2}/>บทก่อนหน้า</small><span>{previous.data.title}</span></a> : <span/>}
        {next && <a class="next-lesson" href={lessonUrl(next)}><small>บทถัดไป<Icon name="arrow" size={16} stroke={2}/></small><span>{next.data.title}</span></a>}
      </nav>
    </article>
    <aside class="contents-rail">
      <details open><summary>ในบทความนี้</summary><nav aria-label="สารบัญในบทความ">{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</nav></details>
      <div class="rail-companion"><span class="rail-mascot-wrap"><Shape kind="sunny" class="rail-mascot-shape"/><Mascot pose="think" class="rail-mascot"/></span><p class="reading-note">ลองพิมพ์ตัวอย่างเอง<br/>แล้วเปลี่ยนค่าดูสักครั้ง</p></div>
    </aside>
  </div>
  <script>
    // Scroll-spy: mark the heading being read in the contents rail.
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.contents-rail nav a')];
    const targets = links.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1)))).filter((el): el is HTMLElement => !!el);
    if (targets.length) {
      let frame = 0;
      const mark = () => {
        frame = 0;
        const active = targets.filter((t) => t.getBoundingClientRect().top < innerHeight * 0.3).at(-1);
        links.forEach((link) => link.toggleAttribute('data-active', !!active && decodeURIComponent(link.hash.slice(1)) === active.id));
      };
      addEventListener('scroll', () => { if (!frame) frame = requestAnimationFrame(mark); }, { passive: true });
      mark();
    }
  </script>
</Base>
