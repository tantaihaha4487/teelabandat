---
import Icon from './Icon.astro';
import { lessons, lessonUrl, sectionUrl, banks } from '../lib/content';
import type { SectionData } from '../lib/types';
interface Props { sections: SectionData[]; }
const { sections } = Astro.props;
const allLessons = await lessons();
const allBanks = banks();
---
<div class="section-index">
  {sections.map((section, i) => {
    const entries = allLessons.filter(l => l.data.section === section.id);
    const bank = allBanks.find(b => b.id === section.bank);
    return <article class:list={['chapter-row', `chapter-${section.icon}`]}>
      <div class="chapter-number" aria-hidden="true">{String(i+1).padStart(2,'0')}<Icon name={section.icon} size={32}/></div>
      <div class="chapter-body"><p class="eyebrow">{section.label}<span>{section.kind === 'course' ? `${entries.length} บทความ` : `${bank?.questions.length || 0} ข้อ`}</span></p><h3><a href={sectionUrl(section)}>{section.title}</a></h3><p>{section.summary}</p><div class="chapter-links">{entries.filter(l=>!l.id.endsWith('/index')).slice(0,3).map(l=><a href={lessonUrl(l)}>{l.data.title.replace(/สำหรับผู้เริ่มต้น/g,'')} <span aria-hidden="true"><Icon name="external" size={14}/></span></a>)}{section.kind==='practice' && bank?.topics.slice(0,3).map(t=><a href={`${sectionUrl(section)}?topic=${t.id}`}>{t.title} <span aria-hidden="true"><Icon name="external" size={14}/></span></a>)}</div></div>
      <a class="chapter-go" href={sectionUrl(section)} aria-label={`เปิด${section.title}`}><Icon name="arrow" size={27}/></a>
    </article>;
  })}
</div>
