    "@astrojs/vue": "7.1.0",
    "@fontsource/ibm-plex-sans-thai": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "astro": "7.4.0",
    "pyodide": "314.0.7",
    "shiki": "4.5.0",
    "vue": "3.5.44",
    "yaml": "2.8.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "5.9.3",
    "@types/node": "latest"
  }
