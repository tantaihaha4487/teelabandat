{
  "name": "teelabandat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-pyodide-assets.mjs && astro dev --host 127.0.0.1",
    "build": "node scripts/copy-pyodide-assets.mjs && node scripts/validate-content.mjs && astro build",
